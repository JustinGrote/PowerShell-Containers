# syntax=docker/dockerfile:1

#These args will vary based on the build. This is a multi-arch build
ARG DIST=noble-chiseled
ARG PS_VERSION=7.5.1

#This needs to match the pwsh build version. The build script does this detectin work via global.json of the commit of the release
ARG DOTNET_VERSION=9.0

#Autogenerated args based on the build
ARG BUILDPLATFORM TARGETOS TARGETARCH

#You wont typically need to vary these args
ARG PS_PACKAGE_BASE=powershell-${PS_VERSION}-${TARGETOS}
ARG PS_PACKAGE_BASE_URL=https://github.com/PowerShell/PowerShell/releases/download/v${PS_VERSION}/${PS_PACKAGE_BASE}
ARG PS_INSTALL_FOLDER=/opt/microsoft/powershell/7
ARG LANG=en_US.UTF-8
ARG IMAGE=mcr.microsoft.com/dotnet/runtime-deps:$DOTNET_VERSION-$DIST
ARG TAG=$PS_VERSION-$DIST-$TARGETARCH

#STAGE: Install PowerShell
FROM --platform=$BUILDPLATFORM alpine AS install-powershell
ARG PS_INSTALL_FOLDER PS_VERSION PS_PACKAGE_BASE_URL TARGETARCH TARGETPLATFORM
#Passed thru so it can reach the configure stage
RUN mkdir -p $PS_INSTALL_FOLDER
WORKDIR $PS_INSTALL_FOLDER
RUN <<SCRIPT
if [ "${TARGETARCH}" = "amd64" ]; then
	PSARCH="x64"
elif [ "${TARGETARCH}" = "arm64" ]; then
	PSARCH="arm64"
else
	echo "Unsupported architecture: $TARGETARCH"
	exit 1
fi

#Fetch and extract the appropriate zip

echo "Fetching PowerShell $PS_VERSION for $TARGETARCH from $PS_PACKAGE_BASE_URL-$PSARCH.tar.gz"
wget -O /tmp/linux.tar.gz $PS_PACKAGE_BASE_URL-$PSARCH.tar.gz
echo "Extracting to $PS_INSTALL_FOLDER"
tar zxf /tmp/linux.tar.gz -C $PS_INSTALL_FOLDER
chmod a+x,o-w ${PS_INSTALL_FOLDER}/pwsh
chmod a+x,o-w ${PS_INSTALL_FOLDER}/pwsh.dll

# Unnecessary Modules for runtime
rm -rf Schemas Modules/PowerShellGet Modules/Microsoft.PowerShell.PSResourceGet Modules/PackageManagement Modules/PSReadLine
#Unnecessary localization
rm -rf zh-Hans zh-Hant cs de es fr it ja ko pl pt-BR tr ru _manifest ref

# Additional Unnecessary Extras
rm -v Microsoft.PowerShell.*.xml
rm -v ThirdPartyNotices.txt
rm -v System.Directory*.dll System.Data.SqlClient.dll System.Data.Odbc.dll
rm -v System.Drawing.Common.dll System.Speech.dll
SCRIPT

#STAGE: Configure PowerShell
FROM --platform=$TARGETPLATFORM $IMAGE
ARG PS_INSTALL_FOLDER
ARG TAG
COPY --from=install-powershell /opt/microsoft/powershell /opt/microsoft/powershell

# Define ENVs for Localization/Globalization
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=true
ENV LC_ALL=en_US.UTF-8
ENV LANG=en_US.UTF-8

#PowerShell Specific: https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_environment_variables?view=powershell-7.4
ENV POWERSHELL_DISTRIBUTION_CHANNEL=JustinGrote-PowerShell-Containers-$TAG
ENV POWERSHELL_UPDATECHECK=Off

ENTRYPOINT [ "/opt/microsoft/powershell/7/pwsh", "-noni", "-c" ]

#Prepare the Module Analysis Cache
#TODO: Figure out how to run this on arm64
